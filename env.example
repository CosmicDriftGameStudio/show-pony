# show-pony local dev. Copy to .env — the defaults match docker-compose.yml
# and ci.yml, so `docker compose up -d` gives you a Postgres + Redis these
# point at, and integration tests run against the same URLs as CI.
DATABASE_URL=postgresql://kumiko:kumiko@localhost:15432/kumiko_dev
REDIS_URL=redis://localhost:16379
JWT_SECRET=dev-jwt-secret-change-me-in-prod
TEST_DATABASE_URL=postgresql://kumiko:kumiko@localhost:15432/kumiko_test

# Optional — Stripe test mode (leave unset to boot without checkout).
# Use real sk_test_/price_ IDs from your Stripe dashboard to try upgrades locally.
# billingLive stays off until sysadmin flips it in Platform → Stripe settings.
# STRIPE_API_KEY=sk_test_replace_me
# STRIPE_WEBHOOK_SECRET=whsec_replace_me
# STRIPE_PRICE_STARTER=price_replace_me_starter
# STRIPE_PRICE_PRO=price_replace_me_pro

# Optional — PII KMS (crypto-shredding). All-or-none: setting only part of
# PLATFORM_KEK / SUBJECT_KEYS_DATABASE_URL / KUMIKO_BLIND_INDEX_KEY aborts boot.
# Leave all unset for plaintext PII (demo only).
# PLATFORM_KEK=replace_me_base64_32_bytes
# SUBJECT_KEYS_DATABASE_URL=postgresql://kumiko:kumiko@localhost:15432/kumiko_subject_keys
# KUMIKO_BLIND_INDEX_KEY=replace_me_base64_32_bytes
# KEK rotation only: the previous KEK needs its version alongside.
# PLATFORM_KEK_PREVIOUS=replace_me_previous_kek
# PLATFORM_KEK_PREVIOUS_VERSION=1
