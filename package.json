{
  "name": "show-pony",
  "description": "Lightweight guest list / event RSVP — Kumiko sample app. Make an event, share the link, see who's coming.",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "author": "Marc Frost <marc@cosmicdriftgamestudio.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CosmicDriftGameStudio/show-pony.git"
  },
  "scripts": {
    "dev": "PORT=4180 bun run kumiko-dev bin/server.ts",
    "start": "bun bin/main.ts",
    "check": "bun kumiko check",
    "build": "bun kumiko-build && bun scripts/copy-marketing-assets.ts",
    "prepare": "[ \"$HUSKY\" = \"0\" ] || git config core.hooksPath .husky 2>/dev/null || true",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e/tsconfig.json",
    "lint": "biome check .",
    "test": "bun --config=bunfig.toml test --timeout=5000 --dots",
    "test:unit": "bun --config=bunfig.toml test --timeout=5000 --dots",
    "test:dom": "bun test --dots --config=bunfig.dom.toml --pass-with-no-tests .test.tsx",
    "test:integration": "bun kumiko-testing integration --parallel 4",
    "test:integration:ci": "bun kumiko-testing integration --parallel 4",
    "test:real": "KUMIKO_REAL_PROVIDERS=1 bun --config=bunfig.real.toml test --timeout=240000 real.test.ts",
    "test:bunfig": "bun kumiko-testing bunfig",
    "screenshots": "bunx --bun playwright test --config=playwright.screenshots.config.ts",
    "e2e": "bunx --bun playwright test",
    "e2e:real": "KUMIKO_REAL_PROVIDERS=1 bunx --bun playwright test",
    "loops:check": "bun scripts/check-loops.ts",
    "loops": "bun run loops:check && bun run e2e",
    "loops:dry-run": "bunx --bun playwright test --list"
  },
  "dependencies": {
    "@cosmicdrift/kumiko-bundled-features": "0.409.0",
    "@cosmicdrift/kumiko-dev-server": "0.409.0",
    "@cosmicdrift/kumiko-document-designer": "0.409.0",
    "@cosmicdrift/kumiko-server-runtime": "0.409.0",
    "@cosmicdrift/kumiko-types": "0.409.0",
    "@cosmicdrift/kumiko-framework": "0.409.0",
    "@cosmicdrift/kumiko-locale-de": "0.409.0",
    "@cosmicdrift/kumiko-renderer": "0.409.0",
    "meilisearch": "^0.62.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@cosmicdrift/kumiko-cli": "0.409.0",
    "@cosmicdrift/kumiko-guards": "0.409.0",
    "@cosmicdrift/kumiko-testing": "0.409.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/cli": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "bun-types": "^1.4.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@cosmicdrift/kumiko-framework": "0.409.0",
    "@cosmicdrift/kumiko-bundled-features": "0.409.0",
    "@cosmicdrift/kumiko-dev-server": "0.409.0",
    "@cosmicdrift/kumiko-document-designer": "0.409.0",
    "@cosmicdrift/kumiko-server-runtime": "0.409.0",
    "@cosmicdrift/kumiko-renderer": "0.409.0",
    "@cosmicdrift/kumiko-locale-de": "0.409.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "hono": "^4.13.14",
    "brace-expansion": "^5.0.12",
    "html-to-text": "10.0.1",
    "ip-address": "^10.7.5",
    "undici": "7.30.1",
    "happy-dom": "21.0.4"
  },
  "kumiko": {
    "deploy": {
      "infraRef": "reusables-v2.0.0"
    },
    "clientEntries": [
      {
        "name": "admin",
        "sourceFile": "./src/client-admin.tsx",
        "htmlPath": "./public/admin.html"
      },
      {
        "name": "public",
        "sourceFile": "./src/client-public.tsx",
        "htmlPath": "./public/index.html"
      }
    ]
  }
}
